package velos;

struct ObjectMeta {
    name: String,
    uid: Uuid,
    labels: Map<String, String>,
    annotations: Map<String, String>,
    resource_version: u64,
    creation_timestamp: DateTimeUtc,
    deletion_timestamp: Option<DateTimeUtc>,
    finalizers: Vec<String>,
}

enum ContainerPhase {
    Pending,
    Scheduled,
    Running,
    Hibernated,
    Succeeded,
    Failed,
    Unknown,
}

/// The run state the user wants for a container. `spec.desiredState` is the
/// *intent*; `status.phase` is what the worker observes. Hibernating shuts the
/// micro-VM down while keeping the instance (and its disk) so it can be
/// started again — it is not a delete.
enum DesiredState {
    Running,
    Hibernated,
}

enum RestartPolicy {
    Never,
    OnFailure,
    Always,
}

struct ResourceReqs {
    cpu: u32,
    memory_bytes: u64,
}

enum NodeSelectorOperator { In, NotIn, Exists, DoesNotExist, Gt, Lt }

struct NodeSelectorRequirement {
    key: String,
    operator: NodeSelectorOperator,
    values: Vec<String>,
}

struct NodeSelectorTerm {
    match_expressions: Vec<NodeSelectorRequirement>,
}

struct PreferredSchedulingTerm {
    weight: i32,
    preference: NodeSelectorTerm,
}

struct NodeAffinity {
    required: Vec<NodeSelectorTerm>,
    preferred: Vec<PreferredSchedulingTerm>,
}

enum TaintEffect { NoSchedule, PreferNoSchedule }

struct Taint {
    key: String,
    value: String,
    effect: TaintEffect,
}

enum TolerationOperator { Equal, Exists }

struct Toleration {
    key: String,
    operator: TolerationOperator,
    value: String,
    effect: Option<TaintEffect>,
}

struct ContainerSpec {
    image: String,
    command: Vec<String>,
    env: Map<String, String>,
    resources: ResourceReqs,
    restart_policy: RestartPolicy,
    desired_state: DesiredState,
    node_name: Option<String>,
    node_selector: Map<String, String>,
    affinity: Option<NodeAffinity>,
    tolerations: Vec<Toleration>,
}

struct ContainerStatus {
    phase: ContainerPhase,
    worker_name: Option<String>,
    container_id: Option<String>,
    started_at: Option<DateTimeUtc>,
    hibernated_at: Option<DateTimeUtc>,
    finished_at: Option<DateTimeUtc>,
    exit_code: Option<i32>,
    message: Option<String>,
}

struct Container {
    metadata: ObjectMeta,
    spec: ContainerSpec,
    status: ContainerStatus,
}

struct NodeResources {
    cpu: u32,
    memory_bytes: u64,
}

enum NodeConditionType {
    Ready,
}

struct NodeCondition {
    condition_type: NodeConditionType,
    status: bool,
    last_transition_time: DateTimeUtc,
    reason: String,
}

struct WorkerSpec {
    unschedulable: bool,
    taints: Vec<Taint>,
}

struct NodeSystemInfo {
    agent_version: String,
    os: String,
    arch: String,
    hostname: String,
}

struct WorkerStatus {
    capacity: NodeResources,
    allocatable: NodeResources,
    conditions: Vec<NodeCondition>,
    addresses: Vec<String>,
    container_runtime_version: String,
    node_info: NodeSystemInfo,
}

struct Worker {
    metadata: ObjectMeta,
    spec: WorkerSpec,
    status: WorkerStatus,
}

struct LeaseSpec {
    holder_identity: String,
    renew_time: DateTimeUtc,
    lease_duration_seconds: u32,
}

struct Lease {
    metadata: ObjectMeta,
    spec: LeaseSpec,
}

#[type_tag = "type"]
#[content_tag = "object"]
union WatchEvent {
    Added(Any),
    Modified(Any),
    Deleted(Any),
}

struct RegisterRequest {
    name: String,
    capacity: NodeResources,
    addresses: Vec<String>,
    container_runtime_version: String,
    node_info: NodeSystemInfo,
}

struct WorkerCredential {
    worker_name: String,
    token: String,
}

struct BootstrapTokenInfo {
    token_id: String,
    secret: String,
    expires_at: DateTimeUtc,
}

// ---------------------------------------------------------------------------
// Service — a stable name in front of a moving set of containers.
// ---------------------------------------------------------------------------

/// One port a `Service` exposes.
///
/// Velos has no cluster IP. Each worker's container network is its own island
/// (Apple Containerization hands every worker the same `192.168.64.0/24`, and
/// it is not routable off that Mac), so there is nothing for a virtual service
/// IP to live on. Kubernetes' `port` field — the cluster-IP port — is therefore
/// deliberately absent: a service port is a `nodePort` bound on every worker
/// running a selected container, forwarded to `targetPort` inside it.
///
/// `nodePort` is server-assigned at admission when the caller leaves it unset,
/// like `uid` and `resourceVersion`; a stored `ServicePort` always has one.
struct ServicePort {
    name: String,
    target_port: u32,
    node_port: u32,
}

struct ServiceSpec {
    selector: Map<String, String>,
    ports: Vec<ServicePort>,
}

/// One address the service is answering on right now. Maintained by the
/// endpoints controller from container placement and worker addresses — this
/// is what an external load balancer is told to send traffic to.
struct ServiceEndpoint {
    worker_name: String,
    address: String,
    node_port: u32,
    container_name: String,
}

struct ServiceStatus {
    endpoints: Vec<ServiceEndpoint>,
}

struct Service {
    metadata: ObjectMeta,
    spec: ServiceSpec,
    status: ServiceStatus,
}
